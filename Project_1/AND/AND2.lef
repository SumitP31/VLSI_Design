VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO AND2
  CLASS BLOCK ;
  FOREIGN AND2 ;
  ORIGIN 4.050 2.890 ;
  SIZE 6.150 BY 3.060 ;
  PIN A
    ANTENNAGATEAREA 0.265500 ;
    PORT
      LAYER li1 ;
        RECT -4.050 -2.040 -3.750 -1.700 ;
    END
  END A
  PIN B
    ANTENNAGATEAREA 0.265500 ;
    PORT
      LAYER li1 ;
        RECT 1.505 -2.040 1.800 -1.700 ;
    END
  END B
  PIN VPWR
    USE POWER ;
    PORT
      LAYER nwell ;
        RECT -3.640 -1.780 1.380 -0.070 ;
      LAYER li1 ;
        RECT -2.985 -0.340 -2.690 0.095 ;
        RECT -3.400 -1.560 -2.690 -0.340 ;
        RECT -0.600 -1.510 -0.330 0.100 ;
        RECT 0.460 -0.320 0.750 0.100 ;
        RECT 0.460 -1.560 1.055 -0.320 ;
      LAYER met1 ;
        RECT -3.745 -0.165 2.100 0.170 ;
        RECT -3.745 -0.170 -2.150 -0.165 ;
        RECT -0.510 -0.170 2.100 -0.165 ;
    END
  END VPWR
  PIN VGND
    USE GROUND ;
    PORT
      LAYER li1 ;
        RECT -3.400 -2.500 -2.690 -2.160 ;
        RECT -1.910 -2.500 -1.200 -2.160 ;
        RECT -2.980 -2.790 -2.690 -2.500 ;
        RECT -1.490 -2.840 -1.200 -2.500 ;
        RECT 0.460 -2.500 1.055 -2.160 ;
        RECT 0.460 -2.830 0.750 -2.500 ;
      LAYER met1 ;
        RECT -3.745 -2.890 2.100 -2.550 ;
    END
  END VGND
  PIN Y
    ANTENNADIFFAREA 0.657000 ;
    PORT
      LAYER li1 ;
        RECT -2.520 -1.775 -1.980 -1.770 ;
        RECT -1.030 -1.775 -0.770 -0.320 ;
        RECT -2.520 -1.945 -0.770 -1.775 ;
        RECT -2.520 -2.500 -2.230 -1.945 ;
        RECT -1.030 -2.500 -0.770 -1.945 ;
    END
  END Y
  OBS
      LAYER pwell ;
        RECT -0.380 0.120 1.130 0.130 ;
      LAYER li1 ;
        RECT -2.520 -0.710 -1.200 -0.340 ;
        RECT -2.520 -1.560 -2.250 -0.710 ;
        RECT -1.490 -1.560 -1.200 -0.710 ;
        RECT 0.000 -1.695 0.290 -0.340 ;
        RECT -0.570 -2.040 0.290 -1.695 ;
        RECT 0.000 -2.500 0.290 -2.040 ;
  END
END AND2
END LIBRARY

